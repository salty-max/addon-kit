#!/bin/sh
# A hook's refusal in the harness's event log, the file events.ts writes and
# the desktop panel reads: _event <tone> <text>. HARNESS_EVENTS names another
# file, "off" none. Never a failure of the hook that calls it.
here=$(cd "$(dirname "$0")" && pwd)
file=${HARNESS_EVENTS:-}
[ "$file" = off ] && exit 0
[ -n "$file" ] || file="${WOW_ADDONS_ROOT:-$(dirname "$(dirname "$here")")}/.cache/harness/events.log"
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
case $common in
*/.git) repo=$(basename "$(dirname "$common")") ;;
*) repo=$(basename "$(pwd)") ;;
esac
text=$(printf '%s' "$2" | tr '\t\r\n' '   ' | sed 's/  */ /g; s/^ //; s/ $//')
mkdir -p "$(dirname "$file")" 2>/dev/null &&
  printf '%s\thook\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$repo" "$text" >>"$file" 2>/dev/null
exit 0
