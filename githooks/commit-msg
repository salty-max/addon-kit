#!/bin/sh
# The family's rule, kept by git: no AI co-author and no "generated with"
# line in a commit message. Then the repository's own commit-msg, if any
# (HARNESS_NO_CHAIN=1: this check alone, as packet.ts runs it on commits).
here=$(cd "$(dirname "$0")" && pwd)
# (an AI's name as a word: a co-author called Claude is refused too, the
# family has none; Cursor only as a co-author, the Codex is one of ours)
ai='(^|[^[:alnum:]_])(claude|anthropic|openai|chatgpt|gpt-?[0-9][[:alnum:].]*|copilot|gemini|aider|codeium|windsurf|devin ai|openai codex|codex cli)([^[:alnum:]_]|$)'
bad=$(grep -v '^#' "$1" | grep -iE \
  -e "^[[:space:]]*(co-authored-by|assisted-by|generated-by|generated-with|made-with):.*($ai|cursor)" \
  -e "^[^[:alnum:]]*generated[- ](with|by).*($ai|[]][(]https?://)" \
  -e '🤖')
if [ -n "$bad" ]; then
  echo "commit-msg: the family's rule, no AI co-author or \"generated with\" line:" >&2
  printf '%s\n' "$bad" | sed 's/^/  /' >&2
  echo "Take it out and commit again (the message is kept in .git/COMMIT_EDITMSG)." >&2
  "$here/_event" fail "commit-msg refused an AI trailer: $(printf '%s\n' "$bad" | head -1)"
  exit 1
fi
[ -n "$HARNESS_NO_CHAIN" ] && exit 0
exec "$here/_chain" commit-msg "$@"
