#!/bin/sh
# Refuses a push whose trees have no passing check. q.ts stamps the tree a
# check passed on (<git common dir>/harness/check-<tree>), and every branch
# or tag this push sends must point at a commit with that tree. Then the
# repository's own pre-push, if any.
here=$(cd "$(dirname "$0")" && pwd)
stamps="$(git rev-parse --path-format=absolute --git-common-dir)/harness"
input=$(mktemp) || exit 1
trap 'rm -f "$input"' EXIT
cat >"$input"
missing=""
nl='
'
while read -r local_ref local_oid remote_ref remote_oid; do
  case $local_oid in *[!0]*) ;; *) continue ;; esac # a deletion
  tree=$(git rev-parse -q --verify "$local_oid^{tree}" 2>/dev/null) || continue
  [ -f "$stamps/check-$tree" ] || missing="$missing  ${remote_ref#refs/*/} ($(git rev-parse --short "$local_oid"))$nl"
done <"$input"
if [ -n "$missing" ]; then
  check=$(git config --get harness.check)
  if [ -z "$check" ]; then
    if [ -f package.json ] && grep -q '"check"[[:space:]]*:' package.json; then check="bun run check"; else check="<the repository's check>"; fi
  fi
  kit=$(cd "$here/.." && pwd)
  {
    echo "pre-push: no passing check for what this push sends:"
    printf '%s' "$missing"
    echo "Run the check on it, then push again:"
    echo "  bun $kit/q.ts check -- $check"
    echo "(a check run on uncommitted files counts for the commit that holds exactly them)"
  } >&2
  exit 1
fi
"$here/_chain" pre-push "$@" <"$input"
